{
  "version": 2,
  "framework": null,

  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "**"
    },
    "api/debug-status.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },

  "outputDirectory": "public",

  "build": {
    "env": {
      "VITE_API_BASE_URL": "/api"
    }
  },

  "rewrites": [
    { "source": "/api/debug-status", "destination": "/api/debug-status.php" },
    { "source": "/build/(.*)", "destination": "/build/$1" },
    { "source": "/(css|js|images|fonts|favicon)/(.*)", "destination": "/$1/$2" },
    { "source": "/(.*)\\.(css|js|png|jpg|jpeg|gif|svg|ico|ttf|woff|woff2|eot|otf|webp|avif|txt)", "destination": "/$1.$2" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ],

  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp",
    "CACHE_STORE": "array",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie"
  }
}